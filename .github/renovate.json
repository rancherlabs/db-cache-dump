{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rancher/renovate-config#release"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "prHourlyLimit": 20,
  "packageRules": [
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Group SUSE BCI base image updates across all Dockerfiles",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.suse.com/bci/bci-base",
        "registry.suse.com/bci/bci-micro"
      ],
      "versioning": "loose",
      "groupName": "bci-base-image",
      "automerge": true
    },
    {
      "description": "k3d CLI updates",
      "matchDepNames": [
        "k3d-io/k3d"
      ],
      "automerge": false
    }
  ],
    "customManagers": [
    {
      "customType": "regex",
      "description": "Track k3d version in e2e workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/e2e\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=k3d-io/k3d\\n.*TAG=v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3d-io/k3d",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
